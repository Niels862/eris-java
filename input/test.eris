class Point {
    x: int;
    y: int;
}

func print(o: int) -> int {
    return 0;
}

func make_point(x: int, y: int) -> Point {
    var p = Point(x, y);
    p.x = x;
    p.y = y;
    return p;
}

func f(x: int?) -> int {
    if x === null {
        return x;
    }
    return 42;
}

func main() -> int {
    var x = make_point(3, 5).x;
    print(x);
    return f(x);
}
